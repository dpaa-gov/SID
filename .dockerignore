# Only what the two builds need is sent to Docker; everything else stays out.
#   build/Dockerfile  compiles SIDJ and server
#   build/Dockerfile.trim  the same, trimmed, from build/trim/entry.jl
#   Dockerfile        copies server/config, web and VERSION, and, for a local
#                     build, a bundle from dist/
*
!SIDJ
!server
!web
!VERSION
!build/trim
!dist/*.tar.gz
SIDJ/test
server/test
**/.DS_Store
